{
  "manifest_version": 3,
  "name": "Tabscope",
  "version": "1.1.0",
  "description": "Fuzzy-find your open tabs by title or URL, telescope.nvim style.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["tabs", "scripting", "activeTab", "favicon", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Tabscope",
    "default_popup": "palette.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "open-tabscope": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Open the tab finder"
    },
    "previous-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "Command+Shift+P"
      },
      "description": "Swap to the previous tab"
    },
    "walk-back": {
      "suggested_key": {
        "default": "Alt+Shift+H",
        "mac": "MacCtrl+H"
      },
      "description": "Walk back through recently used tabs"
    },
    "walk-forward": {
      "suggested_key": {
        "default": "Alt+Shift+L",
        "mac": "MacCtrl+L"
      },
      "description": "Walk forward through recently used tabs"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["palette.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
